		function right(str, chr)
		{
 			 return str.slice(str.length-chr,str.length);
		}
		function SetCGInviteLink()
		{
			if(typeof gCrazySDK !== 'undefined')
			{
				var meta = document.getElementById ("cglink");
				var aStr = meta.value;
				aStr = right(aStr, 8);
				var aCGLink = gCrazySDK.inviteLink({ roomId: aStr });
				meta.value = aCGLink;
				meta.select
				document.execCommand('Copy')
				console.log("COPIED CG URL");
			}
		}

		function ShowAdBreak() {
			//check if the adslib is loaded correctly or blocked by adblockers etc.
			if(typeof gCrazySDK !== 'undefined')
			{
				Main.DoneInterstitialAd(false);
				return;
			}

			if(window.ascAds) {
				console.log('[ASC] ShowAdBreak: skipping interstitial (not supported by asc)');
				Main.DoneInterstitialAd(false);
				return;
			}

			if(window.setupadAds) {
				console.log('[SETUPAD] ShowAdBreak: no interstitial unit, completing immediately');
				Main.DoneInterstitialAd(false);
				return;
			}

			if(window.optiAds) {
				console.log('[OPTI] ShowAdBreak: no interstitial support, completing immediately');
				Main.DoneInterstitialAd(false);
				return;
			}

						if(typeof adplayer === 'undefined' ) {
				Main.DoneInterstitialAd(true);
				return;
			}
			aiptag.cmd.player.push(function() { adplayer.startAdBreak(); });
		}


		document.getElementById("openfl-content").addEventListener("wheel", doScroll);
		document.getElementById("more").addEventListener("wheel", doScroll);
		function doScroll(event) {
  			window.scroll(0, window.scrollY + event.deltaY);
		};

		setInterval(function () {
			//console.log("active element:" + document.activeElement);
			if (document.activeElement.tagName == "IFRAME") {
        		document.activeElement.blur();
				document.getElementById('openfl-content').focus();
				//console.log('refocusing');
    		}
		}, 30);


		var sid = "4f7e0a48977231ae6ee2";
		function updateStatus(fromEvent = false)
		{
			const req = new XMLHttpRequest();
			var aStr = "recordsession.php?s="+sid;
			if(fromEvent == true)  aStr = aStr + "&e=1"
			req.open("GET", aStr);
			req.send();
		}
		function SendEvent(theEvent, theAction, theParms = '') {
			if(theParms == '') {
				gtag(theEvent, theAction);
			} else {
				gtag(theEvent, theAction, theParms);
			}
			updateStatus(true);
			console.log("Sending event: " + theEvent + "/" + theAction + "/" + theParms);
		}
		// Heartbeat, so CCU reflects people who are actually playing.
		//
		// recordsession.php only refreshes a session's Date when updateStatus() runs, and that
		// used to happen on load plus inside SendEvent() — i.e. only on milestones (game start,
		// period end, goal, win/lose). current_ccu.php counts sessions touched in the last 300s,
		// so a player sitting in character select, or grinding through a scoreless period, goes
		// quiet and drops out of CCU while still playing. That's why GA's 5-minute realtime
		// number runs well above ours: gtag keeps its own engagement heartbeat going.
		//
		// 120s leaves two full pings of headroom inside the 300s window, so one dropped request
		// doesn't evict a live player. Pass true: current_ccu.php deletes every FromEvent = 0
		// row outright, and REPLACE INTO keys on SessionUniqueID — a fromEvent=false ping would
		// overwrite the player's good row with one the next sample purges, which is worse than
		// not pinging at all.
		//
		// Only while visible. A backgrounded tab isn't a concurrent user and GA4 doesn't count
		// one either; pinging regardless would push CCU past both GA and the truth.
		setInterval(function() {
			if(document.visibilityState === 'visible') updateStatus(true);
		}, 120*1000);

		// Returning to the tab counts right away rather than up to 120s later.
		document.addEventListener('visibilitychange', function() {
			if(document.visibilityState === 'visible') updateStatus(true);
		});

		//setInterval( function() {
		//	window.scrollTo(0, 0);
		//}, 2000 );
		updateStatus(true);

		//setInterval(ClearAds, 2000);

		function EmailSignup() {
			if(document.getElementById("signup") || document.getElementById("deleteme")) return;
			const iframe = document.createElement("iframe");
			iframe.src = "https://bluewizard.com/subscribe-to-bbros/";

//			iframe.style.display = "block";
			iframe.style.width = "550px";
			iframe.style.height = ""+window.innerHeight-100+"px";
			iframe.style.position = "absolute";
			iframe.style.top = "50px";
			iframe.style.left = "50%";
			iframe.style["margin-left"] = "-225px";
			//iframe.style["margin-right"] = "-275px";
			iframe.style["max-width"] = "100%";
			iframe.setAttribute("id", "signup");

			document.body.appendChild(iframe);
		}

		function HideAllAds(hideSides)
		{
			console.log("HideAllAds");

			// The boot spinner and the logo sit over the game like a banner does, and every
			// screen that clears ads wants them gone too. Haxe's Main.HideAllAds() also asks for
			// these, but do it here as well so calling the page function directly is enough.
			HideAd('loading');
			HideAd('logo');

			// Explicitly hide all ad unit divs
			HideAd(adPrefix+'_300x250');
			HideAd(adPrefix+'_300x250_2');
			HideAd(adPrefix+'_336x280');
			HideAd(adPrefix+'_336x280_2');
			HideAd(adPrefix+'_728x90');
			HideAd(adPrefix+'_728x90_m');
			HideAd(adPrefix+'_970x250');
			HideAd(adPrefix+'_160x600');
			HideAd(adPrefix+'_160x600_2');
			HideAd(adPrefix+'_300x600');

			if(typeof $msstart !== 'undefined')
			{
				$msstart.hideDisplayAdsAsync().then(response => {
					// Returns string indicating success if ad was hidden successfully
				});
				console.log("MS ads destroyed");
			}
			if(typeof gCrazySDK !== 'undefined') {
				gCrazySDK.clearAllBanners();
				console.log("CG ads destroyed");
			}
			if(typeof aipDisplayTag !== 'undefined') {
				// destroy() tears down every zone, so nothing is live afterwards. Skip the call
				// entirely when nothing was showing — HideAllAds fires constantly during play and
				// there's no point destroying an empty set over and over.
				var anyLive = false;
				for (var z in aipZoneLive) { if (aipZoneLive[z]) { anyLive = true; break; } }
				if (anyLive) {
					aipDisplayTag.destroy();
					aipZoneLive = {};
					console.log("AIP ads destroyed");
				}
			}
			if(window.ascAds) {
				console.log('[ASC] HideAllAds: destroying all slots and removing dynamic divs');
				if (typeof pbjs !== 'undefined' && typeof pbjs.destroyAllSlots === 'function') {
					pbjs.destroyAllSlots();
					console.log('[ASC] HideAllAds: destroyAllSlots() called');
				}
				// Remove all dynamically created asc divs from DOM and clear cache
				// so they get recreated fresh on next ShowAscAd
				for (var slotName in ascDivCache) {
					if (ascDivCache[slotName] && ascDivCache[slotName].parentNode) {
						ascDivCache[slotName].parentNode.removeChild(ascDivCache[slotName]);
					}
				}
				ascDivCache = {};
			}
			if(window.setupadAds) {
				HideAllSetupadAds();
			}
			else if(window.optiAds) {
				// Hide, don't remove — see optiHideDiv. The divs and their GPT slots stay bound
				// for the life of the page and get refreshed the next time the game shows them.
				optiAllowed = {};
				for (var key in optiDivs) {
					var d = optiDivs[key];
					if (d) {
						var posTarget = d.closest('.optidigital-wrapper-div') || d;
						posTarget.style.display = 'none';
					}
				}
				console.log('[OPTI] HideAllAds');
			}
			//killAdSubframes();

		}

		function HideAd(divName, justClear) {
			if (justClear === undefined) justClear = false;
			if (window.setupadAds) { HideSetupadAd(divName); return; }
			if (window.optiAds) { HideOptiAd(divName); return; }
			if (window.ascAds) { HideAscAd(divName, justClear); return; }
			var aDiv = document.getElementById(divName);
			if (aDiv != null) {
				if (!justClear) {
					aDiv.style.display = "none";
					aDiv.style.visibility = "hidden";
				}
				// Blowing away the innerHTML throws away the creative, so the zone has to be
				// display()'d again rather than refresh()'d next time round.
				aDiv.innerHTML = " ";
				aipZoneLive[divName] = false;
			}
		}

		// Kill ad-spawned iframes (viewability trackers, verification scripts, etc.)
		// that ad SDKs append to document.body outside of the ad container divs.
		// The game iframe is preserved. The parent-page adinplay SDK stays warm.
		var gameIframeRef = null;
		function killAdSubframes() {
			if (!gameIframeRef) {
				gameIframeRef = document.querySelector('#openfl-content iframe');
			}
			var iframes = document.querySelectorAll('iframe');
			for (var i = iframes.length - 1; i >= 0; i--) {
				var f = iframes[i];
				// Keep the game iframe and the GTM noscript iframe
				if (f === gameIframeRef) continue;
				if (f.parentNode && f.parentNode.tagName === 'NOSCRIPT') continue;
				// Kill it
				f.src = 'about:blank';
				if (f.parentNode) f.parentNode.removeChild(f);
			}
		}

		function ShowAdPosition(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH) {
			if (window.setupadAds) { ShowSetupadAd(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH); return; }
			if (window.optiAds) { ShowOptiAd(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH); return; }
			if (window.ascAds) { ShowAscAd(divName, theX, theY, xAlign, yAlign, doRefresh); return; }
			var aDiv = document.getElementById(divName);
			if (aDiv == null) return;

			aDiv.style.display = "block";
			aDiv.style.visibility = "visible";

			if (doRefresh) {
				switch (divName) {
					case adPrefix+'_160x600':
						var aDiv2 = document.getElementById(divName + "_2");
						if (aDiv2) { aDiv2.style.display = "block"; aDiv2.style.visibility = "visible"; }
						ShowAd1(); return;
					case adPrefix+'_300x250': ShowAd6(); break;
					case adPrefix+'_300x250_2': ShowAd2(); break;
					case adPrefix+'_728x90': ShowAd3(); break;
					case adPrefix+'_336x280': ShowAd4(); break;
					case adPrefix+'_336x280_2': ShowAd7(); break;
					case adPrefix+'_728x90_m': ShowAd8(); break;
					case adPrefix+'_970x250': ShowAd9(); break;
					case adPrefix+'_300x600': ShowAd10(); break;
				}
			}

			var contentDiv = document.getElementById("openfl-content");
			var w2 = contentDiv.offsetWidth;
			var h2 = window.innerHeight;
			var aScaleX = screenW / w2;
			var aScaleY = screenH / h2;
			var adPosX = w2 / 2 + theX / aScaleX;
			var adPosY = h2 / 2 + theY / aScaleY;
			var aDivHeight = aDiv.offsetHeight; if (aDivHeight <= 0) aDivHeight = 280;
			var aDivWidth = aDiv.offsetWidth; if (aDivWidth <= 0) aDivWidth = 336;
			if (yAlign == "center") adPosY -= aDivHeight / 2;
			else if (yAlign == "bottom") adPosY -= aDivHeight;
			if (xAlign == "center") adPosX -= aDivWidth / 2;
			else if (xAlign == "right") adPosX -= aDivWidth;
			adPosX += contentDiv.offsetLeft;
			aDiv.style.left = adPosX + "px";
			aDiv.style.top = adPosY + "px";
		}

		function GamePlayStart() {
			if(typeof gCrazySDK !== 'undefined')
			{
				console.log("GamePlayStart");
				gCrazySDK.gameplayStart();
			}
		}

		function GamePlayStop() {
			if(typeof gCrazySDK !== 'undefined')
			{
				console.log("GamePlayStop");
				gCrazySDK.gameplayStop();
			}
		}

		function HappyTime() {
			if(typeof gCrazySDK !== 'undefined')
			{
				console.log("happytime");
				gCrazySDK.happytime();
			}
		}

		// Show 160x600 side banners during page load if window is wide enough
		function ShowInitialSideBanners() {
			// Neither Opti nor Setupad has a 160x600 unit configured for us, and under both the
			// page owns its own containers — there is nothing here to show.
			if (window.optiAds || window.setupadAds) return;
			var w = window.innerWidth;
			var h = window.innerHeight;
			if (w < 1024 || h < 600) return;

			var leftDiv, rightDiv;
			if (window.ascAds) {
				leftDiv = ascGetOrCreateDiv(adPrefix+'_160x600');
				rightDiv = ascGetOrCreateDiv(adPrefix+'_160x600_2');
			} else {
				leftDiv = document.getElementById(adPrefix+'_160x600');
				rightDiv = document.getElementById(adPrefix+'_160x600_2');
			}

			if (leftDiv) {
				leftDiv.style.display = 'block';
				leftDiv.style.visibility = 'visible';
				leftDiv.style.width = '160px';
				leftDiv.style.left = '0px';
				leftDiv.style.top = '50%';
				leftDiv.style.transform = 'translateY(-50%)';
			}
			if (rightDiv) {
				rightDiv.style.display = 'block';
				rightDiv.style.visibility = 'visible';
				rightDiv.style.width = '160px';
				rightDiv.style.left = 'auto';
				rightDiv.style.right = '0px';
				rightDiv.style.top = '50%';
				rightDiv.style.transform = 'translateY(-50%)';
			}

			ShowAd1();
			console.log('ShowInitialSideBanners: ' + w + 'x' + h);
		}
		window.addEventListener('load', ShowInitialSideBanners);

		// ---------------------------------------------------------------------------------
		// Ad slot debug overlay: add ?addebug=1 to the URL.
		//
		// Tints every ad div and labels it with the zone name, so you can tell an ad that
		// isn't being requested from one that's requested but unfilled, and see whether the
		// slot is landing where you meant it to. Off unless the flag is present.
		// ---------------------------------------------------------------------------------
		window.adDebug = /[?&]addebug=1/.test(window.location.search);
		if (window.adDebug) {
			var adDebugSlots = [prerollId, adPrefix+'_160x600', adPrefix+'_160x600_2', adPrefix+'_300x250',
				adPrefix+'_300x250_2', adPrefix+'_336x280', adPrefix+'_336x280_2', adPrefix+'_728x90',
				adPrefix+'_728x90_m', adPrefix+'_970x250', adPrefix+'_300x600'];
			// Under Setupad the containers are the unit ids, not the size names.
			for (var setupadDebugUnit in setupadUnits) adDebugSlots.push(setupadDebugUnit);

			function paintAdDebug() {
				adDebugSlots.forEach(function(id) {
					var el = document.getElementById(id) || (typeof ascGetDiv === 'function' ? ascGetDiv(id) : null);
					if (!el) return;
					var live = setupadUnits[id] ? setupadLive[id] : aipZoneLive[id];
					var shown = el.style.display !== 'none' && el.style.visibility !== 'hidden';
					// Magenta = requested and live, cyan = shown but never display()'d,
					// dim grey = hidden.
					el.style.outline = '2px solid ' + (live ? '#ff00ff' : (shown ? '#00ffff' : '#666'));
					el.style.backgroundColor = live ? 'rgba(255,0,255,0.28)' : (shown ? 'rgba(0,255,255,0.22)' : 'rgba(120,120,120,0.15)');
					if (!el.dataset.adDebugLabel) {
						var lbl = document.createElement('div');
						lbl.style.cssText = 'position:absolute;top:0;left:0;font:11px/1.3 monospace;color:#fff;background:rgba(0,0,0,0.75);padding:2px 4px;z-index:9999;pointer-events:none;white-space:nowrap;';
						el.appendChild(lbl);
						el.dataset.adDebugLabel = '1';
						el._adDebugLbl = lbl;
					}
					if (el._adDebugLbl && !el._adDebugLbl.parentNode) {
						// HideAd() wipes innerHTML, which takes the label with it.
						el.appendChild(el._adDebugLbl);
					}
					if (el._adDebugLbl) {
						el._adDebugLbl.textContent = id + (live ? ' [live]' : (shown ? ' [shown, not displayed]' : ' [hidden]'))
							+ ' ' + el.offsetWidth + 'x' + el.offsetHeight;
					}
				});
			}
			window.addEventListener('load', function() {
				paintAdDebug();
				setInterval(paintAdDebug, 500);
				console.log('[ADDEBUG] overlay on. prefix=' + adPrefix + ' preroll=' + prerollId);
			});
		}

		var scrollerMessage = "   WELCOME TO HOCKEY BROS!";

		const element = document.getElementById('openfl-content');
		// Ensure 'element' is not null before adding event listeners if there's any chance it might not exist yet.
		// Function to keep the element focused
		function keepFocus() {
			element.focus();
		}
		// Event listeners to restore focus when lost
		element.addEventListener('blur', keepFocus);
		element.addEventListener('focusout', keepFocus);
	</script>
	<script>
		function trackSaveLifespan() {
			try {
				const NOW = Date.now();
				const MS_IN_DAY = 1000 * 60 * 60 * 24;
				
				let saveCreated = localStorage.getItem('bros_save_created_ts');
				let sessionCount = parseInt(localStorage.getItem('bros_local_session_count') || '0', 10);
				
				sessionCount++;
				localStorage.setItem('bros_local_session_count', sessionCount);

				let ageBucket = "";

				if (!saveCreated) {
					// No save found. Mark the creation time.
					localStorage.setItem('bros_save_created_ts', NOW);
					ageBucket = "0_Days (New or Wiped)";
				} else {
					// Save exists! Calculate age in days.
					let ageInDays = Math.floor((NOW - parseInt(saveCreated, 10)) / MS_IN_DAY);
					
					if (ageInDays === 0) ageBucket = "0_Days (Same Day Return)";
					else if (ageInDays === 1) ageBucket = "1_Day";
					else if (ageInDays >= 2 && ageInDays <= 3) ageBucket = "2_to_3_Days";
					else if (ageInDays >= 4 && ageInDays <= 7) ageBucket = "4_to_7_Days";
					else ageBucket = "8_Plus_Days";
				}

				// Fire custom GA4 Event
				gtag('event', 'Save_Persistence_Check', {
					'save_age_bucket': ageBucket,
					'local_session_count': sessionCount
				});
			} catch (e) {
				// Catches strict incognito modes where localStorage is fully blocked
				gtag('event', 'Save_Persistence_Check', {
					'save_age_bucket': 'Storage_Blocked'
				});
			}
		}
		trackSaveLifespan();
	</script>


</body>
