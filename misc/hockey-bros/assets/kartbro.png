	<script>
		// New global state for ad refresh timing and one-time checks
		var adRefreshStates = {};
		var adPrefix = "hockeybros-io";
		var prerollId = "hockeybros.io_preroll";

		// --------------------------------------------------------------------------------
		// AdinPlay zone lifecycle.
		//
		// A zone has to be display()'d before refresh() means anything. Nothing here ever
		// called display() — the only one in the tree lived inside an innerHTML "<script>"
		// string in Main.hx, and innerHTML-injected scripts never execute. So every banner
		// was a refresh() against a zone adinplay had never created: no error, no ad.
		//
		// A zone stops being live when HideAd() wipes the div's innerHTML or HideAllAds()
		// calls destroy(), so both reset the flag and the next show display()s again.
		// --------------------------------------------------------------------------------
		var aipZoneLive = {};

		function showTag(theTag) {
			if (typeof aipDisplayTag === 'undefined') return;
			try {
				if (aipZoneLive[theTag]) {
					aiptag.cmd.display.push(function() { aipDisplayTag.refresh(theTag); });
					console.log('AIP refresh: ' + theTag);
				} else {
					aipZoneLive[theTag] = true;
					aiptag.cmd.display.push(function() { aipDisplayTag.display(theTag); });
					console.log('AIP display: ' + theTag);
				}
			} catch (error) {
				console.error('Error showing the tag:', theTag, error);
			}
		}

		// Kept for callers that specifically want a refresh of an already-live zone.
		function refreshTag(theTag) {
			showTag(theTag);
		}

		// ASC: slot name -> default size mapping (built from config prefix)
		var ascSlotSizes = {};
		ascSlotSizes[adPrefix+'_160x600'] = {w: 160, h: 600};
		ascSlotSizes[adPrefix+'_160x600_2'] = {w: 160, h: 600};
		ascSlotSizes[adPrefix+'_300x250'] = {w: 336, h: 280};
		ascSlotSizes[adPrefix+'_300x250_2'] = {w: 336, h: 280};
		ascSlotSizes[adPrefix+'_336x280'] = {w: 336, h: 600};
		ascSlotSizes[adPrefix+'_336x280_2'] = {w: 336, h: 600};
		ascSlotSizes[adPrefix+'_728x90'] = {w: 728, h: 90};
		ascSlotSizes[adPrefix+'_728x90_m'] = {w: 728, h: 90};
		ascSlotSizes[adPrefix+'_970x250'] = {w: 970, h: 250};
		ascSlotSizes[prerollId] = {w: 960, h: 540};

		// Cache of dynamically created ASC divs (keyed by slot name)
		var ascDivCache = {};

		// ASC helper: get or create a div with ot-name for a given slot
		function ascGetOrCreateDiv(slotName) {
			// Return cached div if it still exists in DOM
			if (ascDivCache[slotName] && ascDivCache[slotName].parentNode) {
				return ascDivCache[slotName];
			}
			var size = ascSlotSizes[slotName] || {w: 300, h: 250};
			var div = document.createElement('div');
			div.setAttribute('ot-name', slotName);
			div.style.width = size.w + 'px';
			div.style.height = size.h + 'px';
			div.style.display = 'none';
			div.style.visibility = 'hidden';
			div.style.position = 'absolute';
			div.style.zIndex = '100';
			div.style.overflow = 'hidden';
			div.style.top = '30px';
			div.style.left = '30px';
			document.getElementById('game2').appendChild(div);
			ascDivCache[slotName] = div;
			console.log('[ASC] Created dynamic div for slot: ' + slotName + ' (' + size.w + 'x' + size.h + ')');
			return div;
		}

		// ASC helper: find existing div by ot-name (for ShowUnitBannerAd compatibility)
		function ascGetDiv(divName) {
			return ascDivCache[divName] || document.querySelector('[ot-name="' + divName + '"]');
		}

		// ASC: timer for batching processAdsOnPage calls
		var ascProcessTimer = null;

		// ASC: called from Haxe Main.ShowAd() when ascAds is true
		function ShowAscAd(divName, theX, theY, xAlign, yAlign, doRefresh) {
			if (/Android|webOS|iPhone|iPad|iPod|Opera Mini/i.test(navigator.userAgent)) return;

			// Dynamically create the ot-name div if it doesn't exist yet
			var aDiv = ascGetOrCreateDiv(divName);

			aDiv.style.display = 'block';
			aDiv.style.visibility = 'visible';

			// Position the div (mirrors Haxe ShowAd positioning logic)
			var contentEl = document.getElementById('openfl-content');
			var w2 = contentEl ? contentEl.offsetWidth : window.innerWidth;
			var h2 = window.innerHeight;
			var aScaleX = 1500 / w2; // Main.SCREENWIDTH
			var aScaleY = 768 / h2;  // Main.SCREENHEIGHT
			var adPosX = w2 / 2 + theX / aScaleX;
			var adPosY = h2 / 2 + theY / aScaleY;

			var aDivHeight = aDiv.offsetHeight || 280;
			var aDivWidth = aDiv.offsetWidth || 336;

			if (yAlign === 'center') adPosY -= aDivHeight / 2;
			else if (yAlign === 'bottom') adPosY -= aDivHeight;
			if (xAlign === 'center') adPosX -= aDivWidth / 2;
			else if (xAlign === 'right') adPosX -= aDivWidth;

			if (contentEl) adPosX += contentEl.offsetLeft;

			aDiv.style.left = adPosX + 'px';
			aDiv.style.top = adPosY + 'px';

			// Batch processAdsOnPage with setTimeout so all ShowAscAd calls in
			// the same frame create their divs first, then ONE processAdsOnPage
			// call discovers and processes them all at once.
			if (doRefresh && typeof pbjs !== 'undefined' && typeof pbjs.processAdsOnPage === 'function') {
				if (ascProcessTimer) clearTimeout(ascProcessTimer);
				ascProcessTimer = setTimeout(function() {
					ascProcessTimer = null;
					pbjs.que.push(function() {
						pbjs.processAdsOnPage();
						console.log('[ASC] processAdsOnPage executed (batched)');
					});
				}, 50);
				SendEvent('event', 'asc_banner_requested');
			}
			console.log('[ASC] ShowAscAd: ' + divName + ' at ' + adPosX + ',' + adPosY);
		}

		// ASC: called from Haxe Main.HideAd() when ascAds is true
		function HideAscAd(divName, justClear) {
			var aDiv = ascGetDiv(divName);
			if (!aDiv) {
				// Not an asc ad div — fall back to getElementById (for loading, logo, etc.)
				aDiv = document.getElementById(divName);
			}
			if (aDiv) {
				if (!justClear) {
					aDiv.style.display = 'none';
					aDiv.style.visibility = 'hidden';
				}
			}
		}

		// ASC: called from Haxe ManageAdSizes() when ascAds is true
		function AscManageAdSizes(shouldHide) {
			var div1 = ascGetDiv(adPrefix+'_160x600');
			var div2 = ascGetDiv(adPrefix+'_160x600_2');
			if (shouldHide) {
				if (div1) { div1.style.width = '0px'; div1.style.display = 'none'; div1.style.visibility = 'hidden'; }
				if (div2) { div2.style.width = '0px'; div2.style.display = 'none'; div2.style.visibility = 'hidden'; }
			} else {
				if (div1) { div1.style.width = '170px'; div1.style.display = 'block'; div1.style.visibility = 'visible'; }
				if (div2) { div2.style.width = '170px'; div2.style.display = 'block'; div2.style.visibility = 'visible'; }
			}
		}

		// =================================================================================
		// Setupad.
		//
		// Their units are placement-named and multi-size. NOTHING below runs at page load:
		// <head> left only the two SDK queues behind, and the first time the game shows an ad
		// setupadBoot() fetches gpt.js and the SaaS bundle, setupadGetOrCreateDiv() builds that
		// one container, and the slot is defined, displayed and initialized — one unit, on
		// demand. Every other unit stays entirely unbuilt until it is asked for.
		//
		// The load sequence is the whole point: the game bundle is ~3MB of JS to compile and
		// Setupad's is Prebid with every adapter attached, so anything that lets the two
		// overlap costs a Chromebook seconds of frozen main thread. Do not move a defineSlot,
		// a container or a <script> back up into <head> to "warm it up".
		//
		// A unit is torn down when the game hides it (stpd.terminateAdunit), which with
		// display + initializeAdUnit is the documented pair. setupadtest.php exercises that
		// cycle with none of the game around it, so if a unit misbehaves here, run it there
		// before blaming Setupad.
		//
		// Hiding is a full teardown — terminate, destroy the GPT slot, empty the container —
		// and a request re-defines the slot on the way back in. Terminating alone leaves the
		// last creative sitting in the container, which shows up as the PREVIOUS ad flashing
		// before the new one arrives. See setupadTeardown for why the steps nest.
		// =================================================================================
		var setupadUnits = {"hockey_bros":{"path":"\/21743024831\/hockey_bros","sizes":[[728,90],[300,250],[250,250],[200,200]],"w":728,"h":90},"midgame":{"path":"\/21743024831\/hockey_bros\/midgame","sizes":[[970,250],[728,90],[300,250],[250,250],[200,200]],"w":970,"h":250},"title_screen":{"path":"\/21743024831\/hockey_bros\/title_screen","sizes":[[300,250],[250,250],[200,200]],"w":300,"h":250},"postgame":{"path":"\/21743024831\/hockey_bros\/postgame","sizes":[[728,90],[300,250],[250,250],[200,200]],"w":728,"h":90},"wait_join":{"path":"\/21743024831\/hockey_bros\/wait_join","sizes":[[300,250],[250,250],[200,200]],"w":300,"h":250},"title_screen_2":{"path":"\/21743024831\/hockey_bros\/title_screen_2","sizes":[[300,250],[250,250],[200,200]],"w":300,"h":250}};
		var setupadSlotMap = {"hockeybros-io_970x250":"midgame","hockeybros-io_728x90":"hockey_bros","hockeybros-io_728x90_m":"postgame","hockeybros-io_300x250":"title_screen","hockeybros-io_300x250_2":"title_screen_2"};
		var setupadAllowed = {};   // game slot names currently wanted on screen
		var setupadPos = {};       // unit -> last requested placement, replayed after a render
		var setupadLive = {};      // unit -> has been initialized and not since torn down
		var setupadLastLoad = {};  // unit -> timestamp of the last request
		var setupadTearing = {};   // unit -> a teardown is still draining through the SDK queues
		var setupadPendingLoad = {}; // unit -> a show arrived mid-teardown and is waiting on it
		var setupadDivs = {};      // unit -> its container, built on first show
		var setupadBooted = false; // have the SDKs been fetched yet?
		var SETUPAD_TAG_ID = "11178";
		var SETUPAD_TINT = true;

		// Fetch gpt.js and the Setupad SaaS bundle, once, at the moment the first ad is really
		// wanted — not at page load. The GPT config is queued before either script exists;
		// googletag.cmd replays in order, so it is guaranteed to run before the first display().
		function setupadBoot() {
			if (setupadBooted) return;
			setupadBooted = true;
			googletag.cmd.push(function() {
				googletag.pubads().disableInitialLoad();
				googletag.pubads().enableSingleRequest();
				googletag.pubads().collapseEmptyDivs();
				googletag.enableServices();
			});
			[ 'https://securepubads.g.doubleclick.net/tag/js/gpt.js',
			  'https://stpd.cloud/saas/' + SETUPAD_TAG_ID ].forEach(function(src) {
				var s = document.createElement('script');
				s.async = true;
				s.src = src;
				document.head.appendChild(s);
			});
			console.log('[SETUPAD] boot: fetching gpt.js + SaaS bundle (first ad requested)');
		}

		// A unit's container, or null if it has never been shown. Lookup only — never builds,
		// so hide/teardown/position paths can't bring a container into being for a unit the
		// game has not actually asked for.
		function setupadDiv(unit) {
			return setupadDivs[unit] || null;
		}

		// Build a unit's container the first time it is shown. Deliberately not in the markup:
		// a container that already exists is something Setupad's wrapper can discover and
		// auction without us asking, which is exactly the all-five-at-once load we are avoiding.
		function setupadGetOrCreateDiv(unit) {
			if (setupadDivs[unit]) return setupadDivs[unit];
			var cfg = setupadUnits[unit];
			if (!cfg) return null;
			var div = document.createElement('div');
			// The id IS the GPT slot element id and the name stpd.initializeAdUnit() takes.
			div.id = unit;
			div.style.cssText = 'width:' + cfg.w + 'px;height:' + cfg.h + 'px;display:none;' +
				'visibility:hidden;position:absolute;top:30px;left:30px;z-index:100;overflow:hidden;' +
				(SETUPAD_TINT ? 'background:rgba(128,128,128,0.25);' : '');
			(document.getElementById('game2') || document.body).appendChild(div);
			setupadDivs[unit] = div;
			console.log('[SETUPAD] created container ' + unit);
			return div;
		}

		// The game can ask for the same banner more than once for one event (a goal that lands
		// on the buzzer re-shows the floor banner for the intermission). Re-requesting inside
		// this window would burn an impression on an ad nobody has looked at yet.
		var SETUPAD_MIN_RELOAD_MS = 10000;

		// Point a game slot at a different Setupad unit, for trying a placement without a
		// redeploy. The static map already covers every slot the game shows.
		function SetSetupadUnit(divName, unitId) {
			if (!setupadUnits[unitId]) { console.log('[SETUPAD] SetSetupadUnit: unknown unit ' + unitId); return; }
			var prev = setupadSlotMap[divName];
			if (prev === unitId) return;
			setupadSlotMap[divName] = unitId;
			// Another name may still point at the unit we moved off, so take it down only once
			// nothing does.
			if (prev) setupadReleaseUnit(prev);
			console.log('[SETUPAD] ' + divName + ' -> ' + unitId);
		}

		// Is any game slot mapped to this unit currently meant to be on screen? Nothing shares
		// a unit in the default map any more, but SetSetupadUnit can make two names collide, so
		// the check stays.
		function setupadWanted(unit) {
			for (var name in setupadSlotMap) {
				if (setupadSlotMap[name] === unit && setupadAllowed[name]) return true;
			}
			return false;
		}

		// Hide a unit unless some game slot still mapped to it is meant to be on screen.
		function setupadReleaseUnit(unit) {
			if (setupadWanted(unit)) return;
			setupadHideUnit(unit);
		}

		function setupadSlot(unit) {
			var slots = googletag.pubads().getSlots();
			for (var i = 0; i < slots.length; i++) {
				if (slots[i].getSlotElementId() === unit) return slots[i];
			}
			return null;
		}

		// Place the container using the coordinates the game gave us. Called on show with the
		// unit's nominal size, and again from slotRenderEnded with whatever actually filled —
		// a 300x250 landing in the 970x250 floor slot still has to sit on the floor, centred.
		function setupadPosition(unit, w, h) {
			var p = setupadPos[unit];
			var el = setupadDiv(unit);
			if (!p || !el) return;
			if (!w || !h) { w = p.w; h = p.h; }

			var contentDiv = document.getElementById('openfl-content');
			var w2 = contentDiv ? contentDiv.offsetWidth : window.innerWidth;
			var h2 = window.innerHeight;
			var adPosX = w2 / 2 + p.x / (p.screenW / w2);
			var adPosY = h2 / 2 + p.y / (p.screenH / h2);

			if (p.yAlign === 'center') adPosY -= h / 2;
			else if (p.yAlign === 'bottom') adPosY -= h;
			if (p.xAlign === 'center') adPosX -= w / 2;
			else if (p.xAlign === 'right') adPosX -= w;

			if (contentDiv) adPosX += contentDiv.offsetLeft;

			el.style.width = w + 'px';
			el.style.height = h + 'px';
			el.style.left = adPosX + 'px';
			el.style.top = adPosY + 'px';
		}

		// display() activates the slot, initializeAdUnit() runs their auction and renders.
		// Both queues are pushed rather than called: gpt.js and the SaaS bundle are async, and
		// the first banner of a session is routinely asked for before either has landed.
		//
		// The slot is always (re)defined here rather than relied on from <head>, because every
		// teardown destroys it — see setupadTeardown.
		function setupadRequest(unit) {
			var cfg = setupadUnits[unit];
			if (!cfg) return;
			setupadBoot();
			setupadLastLoad[unit] = new Date().getTime();
			setupadLive[unit] = true;
			googletag.cmd.push(function() {
				if (!setupadSlot(unit)) {
					googletag.defineSlot(cfg.path, cfg.sizes, unit).addService(googletag.pubads());
				}
				googletag.display(unit);
			});
			stpd.que.push(function() {
				if (typeof stpd.initializeAdUnit !== 'function') {
					console.warn('[SETUPAD] initializeAdUnit missing — SaaS bundle blocked?');
					return;
				}
				stpd.initializeAdUnit(unit);
			});
			SendEvent('event', 'setupad_banner_requested');
		}

		// Take a unit all the way down, then optionally do something once it's down.
		//
		// terminateAdunit() on its own only stops Setupad's refresh timer — the creative it
		// last rendered stays in the container, so the next show flashed the PREVIOUS ad before
		// the new one arrived. Destroying the GPT slot is what unbinds the iframe, and clearing
		// innerHTML catches whatever is left; setupadRequest re-defines the slot on the way
		// back in.
		//
		// The steps nest rather than run on a timer. Both queues are drained asynchronously by
		// SDKs we don't control, so a terminate pushed to stpd.que and a display() pushed to
		// googletag.cmd have no guaranteed order between them — the 50ms gap this used to rely
		// on is exactly how a re-requested slot could get torn down again straight after being
		// rebuilt, and then stay blank until something else showed it.
		function setupadTeardown(unit, then) {
			setupadLive[unit] = false;
			setupadTearing[unit] = true;
			stpd.que.push(function() {
				if (typeof stpd.terminateAdunit === 'function') stpd.terminateAdunit(unit);
				googletag.cmd.push(function() {
					var slot = setupadSlot(unit);
					if (slot) googletag.destroySlots([slot]);
					var el = setupadDiv(unit);
					if (el) el.innerHTML = '';
					setupadTearing[unit] = false;
					if (then) { then(); return; }
					// A show that landed mid-teardown parked itself rather than racing it.
					if (setupadPendingLoad[unit]) {
						setupadPendingLoad[unit] = false;
						if (setupadWanted(unit)) setupadLoad(unit);
						return;
					}
					setupadSweepFrames();
				});
			});
		}

		// Frames that must survive a sweep whatever else goes.
		//
		// The IAB locator frames are how a CMP is found at all (window.frames['__tcfapiLocator']),
		// and goog_topics_frame is GPT's own. They are named by spec, they are not creatives, and
		// removing them breaks consent signalling and every later ad request.
		var SETUPAD_KEEP_FRAME = /Locator$|^goog_topics_frame$|^google_esf$/;
		var setupadGameFrame = null;

		// Ad creatives and their verification vendors (viewability, brand safety, user sync)
		// append iframes to document.body, OUTSIDE the slot container. destroySlots() takes the
		// slot's own iframe and innerHTML='' takes what was inside the container — neither
		// touches these, so every auction leaves another set behind and they keep running.
		// Across a match that is one set per goal, which is why the banner after a goal is the
		// one that makes a Chromebook crawl, and why it stays choppy after the ad is gone.
		//
		// A leftover frame that holds focus is also what feeds the 30ms activeElement watchdog
		// further down this file: it blurs and refocuses 33 times a second, forever.
		//
		// Only ever runs with nothing live, so it cannot remove a frame belonging to an ad that
		// is currently on screen — that is the whole safety argument, and it means the sweep
		// happens during play, when the CPU should be the game's anyway.
		function setupadSweepFrames() {
			for (var u in setupadUnits) {
				if (setupadLive[u] || setupadTearing[u]) return;
			}
			if (!setupadGameFrame) setupadGameFrame = document.querySelector('#openfl-content iframe');
			var frames = document.getElementsByTagName('iframe');
			var killed = 0;
			for (var i = frames.length - 1; i >= 0; i--) {
				var f = frames[i];
				if (f === setupadGameFrame) continue;
				if (f.parentNode && f.parentNode.tagName === 'NOSCRIPT') continue;
				if (SETUPAD_KEEP_FRAME.test(f.name || '')) continue;
				// Leave zero-area frames alone. Bidder user-sync pixels are 0x0 or 1x1, they
				// fire once and then idle, and they are what lets the next auction match a
				// user — sweeping them costs bid density on every later request and buys no
				// CPU back, because the frames that actually keep working are the viewability
				// and verification ones attached to a rendered creative, and those have size.
				if (f.offsetWidth <= 1 && f.offsetHeight <= 1) continue;
				try { f.src = 'about:blank'; } catch (e) {}
				if (f.parentNode) f.parentNode.removeChild(f);
				killed++;
			}
			if (killed) console.log('[SETUPAD] swept ' + killed + ' leftover ad frame(s)');
		}

		// Console helper: what is still on the page right now. Run it on the Chromebook after a
		// few goals — a count that climbs per goal is a leak the sweep is not catching.
		function SetupadFrameReport() {
			var frames = document.getElementsByTagName('iframe');
			var kept = [], other = [];
			for (var i = 0; i < frames.length; i++) {
				var f = frames[i];
				var tag = (f.name || f.id || '(anonymous)') + ' ' + (f.src || '').slice(0, 60);
				(f === setupadGameFrame || SETUPAD_KEEP_FRAME.test(f.name || '') ? kept : other).push(tag);
			}
			console.log('[SETUPAD] frames: ' + frames.length + ' total, ' + other.length + ' sweepable');
			console.log('  live units : ' + Object.keys(setupadUnits).filter(function (u) { return setupadLive[u]; }));
			other.forEach(function (t) { console.log('  sweepable: ' + t); });
			kept.forEach(function (t) { console.log('  kept     : ' + t); });
			return frames.length;
		}

		function setupadLoad(unit) {
			// stpd.que and googletag.cmd drain independently, so a request issued while a
			// teardown is still working its way through them can be destroyed by the tail of
			// that teardown and leave the slot blank. Wait for it instead.
			if (setupadTearing[unit]) {
				setupadPendingLoad[unit] = true;
				console.log('[SETUPAD] ' + unit + ': teardown in flight, load queued');
				return;
			}
			var now = new Date().getTime();
			if (setupadLive[unit]) {
				if (now - (setupadLastLoad[unit] || 0) < SETUPAD_MIN_RELOAD_MS) {
					console.log('[SETUPAD] ' + unit + ': still fresh, not re-requesting');
					return;
				}
				// A live unit has to be torn down before it will take a new request.
				setupadTeardown(unit, function() { setupadRequest(unit); });
				return;
			}
			setupadRequest(unit);
		}

		function setupadHideUnit(unit) {
			var el = setupadDiv(unit);
			if (el) {
				el.style.display = 'none';
				el.style.visibility = 'hidden';
			}
			setupadPendingLoad[unit] = false;
			if (setupadLive[unit]) setupadTeardown(unit);
		}

		// Called from Haxe Main.ShowAd() (via ShowOptiAd) when setupadAds is true.
		function ShowSetupadAd(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH) {
			if (/Android|webOS|iPhone|iPad|iPod|Opera Mini/i.test(navigator.userAgent)) return;
			var unit = setupadSlotMap[divName];
			if (!unit) { console.log('[SETUPAD] ShowSetupadAd: no unit for ' + divName); return; }
			var cfg = setupadUnits[unit];
			var el = setupadGetOrCreateDiv(unit);
			if (!cfg || !el) { console.warn('[SETUPAD] ShowSetupadAd: no container for ' + unit); return; }

			setupadAllowed[divName] = true;
			setupadPos[unit] = { x: theX, y: theY, xAlign: xAlign, yAlign: yAlign,
			                     screenW: screenW, screenH: screenH, w: cfg.w, h: cfg.h };

			// Show before requesting. Setupad will not fill a container it can't see, and the
			// hide-then-request order is what the GAME cycle button in setupadtest.php is for.
			el.style.display = 'block';
			el.style.visibility = 'visible';
			setupadPosition(unit);

			// doRefresh=false means "don't burn a fresh request, the ad is already there" — it
			// dates from adinplay, where hiding a zone left the creative in the div and showing
			// it again just un-hid it. Nothing here works that way: hiding destroys the slot and
			// empties the container, and a unit that has never loaded has nothing to reveal at
			// all. So the flag only suppresses a RE-request; an unloaded unit always loads.
			//
			// TitleScreen is the only caller that passes false (on its first show, and again on
			// every relayout), which is why the title screen was the one screen left blank once
			// the pre-built containers went away and Setupad's wrapper stopped auto-auctioning
			// them for us.
			if (doRefresh || !setupadLive[unit]) setupadLoad(unit);
			console.log('[SETUPAD] show ' + divName + ' -> ' + unit + ' at ' + el.style.left + ',' + el.style.top);
		}

		// Called from Haxe Main.HideAd() (via HideOptiAd) when setupadAds is true.
		function HideSetupadAd(divName) {
			delete setupadAllowed[divName];
			var unit = setupadSlotMap[divName];
			if (!unit) {
				// Not a banner — 'loading', 'logo' and friends still come through here.
				var other = document.getElementById(divName);
				if (other) { other.style.display = 'none'; other.style.visibility = 'hidden'; }
				return;
			}
			// A unit can be driven by more than one name; only tear it down once nothing wants it.
			setupadReleaseUnit(unit);
		}

		function HideAllSetupadAds() {
			setupadAllowed = {};
			for (var unit in setupadUnits) setupadHideUnit(unit);
			// Nothing was live to tear down (so no teardown will call the sweep), but a previous
			// cycle may still have left frames behind. Cheap: it early-outs if anything is live.
			setupadSweepFrames();
			console.log('[SETUPAD] HideAllAds');
		}

		if (window.setupadAds) {
			googletag.cmd.push(function() {
				googletag.pubads().addEventListener('slotRenderEnded', function(e) {
					var unit = e.slot.getSlotElementId();
					if (!setupadUnits[unit]) return;
					if (e.isEmpty || !e.size || !e.size.length) {
						console.log('[SETUPAD] ' + unit + ': no fill');
						return;
					}
					// Re-anchor to the creative that actually arrived — every unit accepts
					// several sizes, so the box the game reserved is an upper bound, not a
					// promise.
					setupadPosition(unit, e.size[0], e.size[1]);
					console.log('[SETUPAD] ' + unit + ': rendered ' + e.size[0] + 'x' + e.size[1]);
				});
			});
		}

		// Opti Digital: slot mapping from AIP div names to Opti slot class names.
		// w/h = known ad dimensions. Divs are created lazily on first show (creating them up
		// front would leave Opti lazy-loading slots that are display:none and never load), then
		// kept for the life of the page and refreshed — see optiHideDiv.
		//
		// Slots the game asks for that are NOT in here (160x600, 336x280) are a deliberate no-op
		// under Opti: banners only, and Opti has no skyscraper unit configured for us.
		var optiSlotMap = {};
		var optiAllowed = {};   // which divNames are currently allowed to be visible
		var optiDivs = {};      // dynamically created divs, keyed by className
		if (window.optiAds && !window.setupadAds) {
			optiSlotMap[adPrefix+'_970x250'] = { className: 'Billboard_1', w: 970, h: 250 };
			optiSlotMap[adPrefix+'_728x90'] = { className: 'Leaderboard_1', w: 728, h: 90 };
			optiSlotMap[adPrefix+'_728x90_m'] = { className: 'Leaderboard_1', w: 728, h: 90 };
			optiSlotMap[adPrefix+'_300x250'] = { className: 'Rectangle_1', w: 300, h: 250 };
			optiSlotMap[adPrefix+'_300x250_2'] = { className: 'Rectangle_2', w: 300, h: 250 };
			optiSlotMap[adPrefix+'_300x600'] = { className: 'HalfpageAd_1', w: 300, h: 600 };
		}

		// Look up an existing Opti div without creating one.
		function optiGetDiv(slot) {
			return optiDivs[slot.className] || null;
		}

		// Apply stored positioning to the current posTarget (wrapper if wrapped, else inner div)
		function optiApplyPosition(div) {
			var pos = div._optiPos;
			if (!pos) return;
			var posTarget = div.closest('.optidigital-wrapper-div') || div;
			posTarget.style.display = 'block';
			posTarget.style.position = 'absolute';
			posTarget.style.zIndex = '100';
			posTarget.style.width = pos.w + 'px';
			posTarget.style.height = pos.h + 'px';
			posTarget.style.left = pos.x + 'px';
			posTarget.style.top = pos.y + 'px';
		}

		// Get the Opti div for a slot, creating it on first call.
		// Opti's SDK auto-discovers new divs, sets up the GPT slot, and loads the ad.
		// On first creation, also installs a MutationObserver so when the SDK wraps our div
		// with .optidigital-wrapper-div we re-apply positioning to the wrapper.
		function optiGetOrCreateDiv(slot) {
			if (optiDivs[slot.className]) return optiDivs[slot.className];
			var div = document.createElement('div');
			div.className = slot.className;
			div.style.position = 'absolute';
			div.style.zIndex = '100';
			div.style.overflow = 'hidden';
			div.style.display = 'block';
			document.body.appendChild(div);
			optiDivs[slot.className] = div;

			// Watch for the SDK wrapping our div — re-apply positioning to the wrapper when it appears
			var wrapped = false;
			var observer = new MutationObserver(function() {
				if (wrapped) return;
				if (div.closest('.optidigital-wrapper-div')) {
					wrapped = true;
					optiApplyPosition(div);
					console.log('[OPTI] .' + slot.className + ' wrapped, re-applied position');
					observer.disconnect();
				}
			});
			observer.observe(document.body, { childList: true, subtree: true });

			console.log('[OPTI] created div .' + slot.className);
			return div;
		}

		// Override the Opti Digital ad unit path (e.g. /21743024831/hockey_bros/home)
		function SetOptiAdUnit(path) {
			if (!window.optiAds) return;
			try {
				if (typeof odT !== 'undefined' && odT.initConfig) {
					odT.initConfig.adUnit = path;
					console.log('[OPTI] adUnit set to: ' + path);
				} else {
					console.log('[OPTI] SetOptiAdUnit: odT not ready, queuing');
					// Retry once after a short delay in case SDK hasn't initialized yet
					setTimeout(function() {
						if (typeof odT !== 'undefined' && odT.initConfig) {
							odT.initConfig.adUnit = path;
							console.log('[OPTI] adUnit set to (delayed): ' + path);
						}
					}, 500);
				}
			} catch(e) { console.log('[OPTI] SetOptiAdUnit error: ' + e); }
		}

		// Entry point the shipped game bundle calls for any page-managed provider — Setupad
		// takes it when it's the active one. See the window.optiAds note in <head>.
		function ShowOptiAd(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH) {
			if (window.setupadAds) { ShowSetupadAd(divName, theX, theY, xAlign, yAlign, doRefresh, screenW, screenH); return; }
			if (/Android|webOS|iPhone|iPad|iPod|Opera Mini/i.test(navigator.userAgent)) return;
			var slot = optiSlotMap[divName];
			if (!slot) { console.log('[OPTI] ShowOptiAd: no mapping for ' + divName); return; }

			// First show creates the div; Opti's module discovers it and loads the initial ad by
			// itself, so a refresh on that same call would double-request the slot.
			var isFirstShow = !optiDivs[slot.className];
			var aDiv = optiGetOrCreateDiv(slot);

			// Position using known dimensions
			var contentEl = document.getElementById('openfl-content');
			var w2 = contentEl ? contentEl.offsetWidth : window.innerWidth;
			var h2 = window.innerHeight;
			var aScaleX = screenW / w2;
			var aScaleY = screenH / h2;
			var adPosX = w2 / 2 + theX / aScaleX;
			var adPosY = h2 / 2 + theY / aScaleY;

			if (yAlign === 'center') adPosY -= slot.h / 2;
			else if (yAlign === 'bottom') adPosY -= slot.h;
			if (xAlign === 'center') adPosX -= slot.w / 2;
			else if (xAlign === 'right') adPosX -= slot.w;

			if (contentEl) {
				adPosX += contentEl.offsetLeft;
				adPosY += contentEl.offsetTop;
			}

			// Store desired position so the wrap observer can re-apply it after SDK wraps the div
			aDiv._optiPos = { x: adPosX, y: adPosY, w: slot.w, h: slot.h };
			optiApplyPosition(aDiv);

			optiAllowed[divName] = true;

			// Refresh GPT slot if it exists. On first show the SDK hasn't yet bound a slot —
			// it will discover the new div and load the initial ad on its own.
			if (doRefresh && !isFirstShow) {
				googletag.cmd.push(function() {
					if (!optiAllowed[divName]) return;
					var gptSlots = googletag.pubads().getSlots();
					for (var i = 0; i < gptSlots.length; i++) {
						var slotEl = gptSlots[i].getSlotElementId();
						var el = document.getElementById(slotEl);
						if (el && aDiv.contains(el)) {
							googletag.pubads().refresh([gptSlots[i]]);
							console.log('[OPTI] GPT refresh slot: ' + slotEl + ' for ' + divName);
							break;
						}
					}
				});
				SendEvent('event', 'opti_banner_requested');
			}
			console.log('[OPTI] ShowOptiAd: ' + divName + ' -> .' + slot.className + ' at ' + Math.round(adPosX) + ',' + Math.round(adPosY));
		}

		// Hide a slot without tearing it down. Removing the div (what this used to do) orphans the
		// GPT slot Opti bound to it, and the next show creates a second slot for the same class —
		// over a match's worth of goals and intermissions that piles up duplicate slots and Opti
		// stops filling. Keep the div, hide it, refresh it on the next show instead.
		function optiHideDiv(slot) {
			var aDiv = optiDivs[slot.className];
			if (!aDiv) return;
			var posTarget = aDiv.closest('.optidigital-wrapper-div') || aDiv;
			posTarget.style.display = 'none';
		}

		function HideOptiAd(divName) {
			if (window.setupadAds) { HideSetupadAd(divName); return; }
			delete optiAllowed[divName];
			var slot = optiSlotMap[divName];
			if (slot) {
				// Two div names can share one class (728x90 / 728x90_m -> Leaderboard_1); only
				// hide once nothing still wants it on screen.
				for (var other in optiSlotMap) {
					if (optiSlotMap[other].className === slot.className && optiAllowed[other]) return;
				}
				optiHideDiv(slot);
			} else {
				var aDiv = document.getElementById(divName);
				if (aDiv) aDiv.style.display = 'none';
			}
		}


		// Base function to show a single banner ad unit
		function ShowUnitBannerAd(config) {
			if (!config.allowMobile && /Android|webOS|iPhone|iPad|iPod|Opera Mini/i.test(navigator.userAgent)) {
				return;
			}

			if (config.minWindowWidth && window.innerWidth < config.minWindowWidth) {
				return;
			}

			const now = new Date().getTime();
			if (!adRefreshStates[config.timerId]) {
				adRefreshStates[config.timerId] = 0; // Initialize if not set
			}

			if (config.refreshTimeout > 0 && (now - adRefreshStates[config.timerId] < config.refreshTimeout)) {
				return;
			}

			var adElement;
			if (window.ascAds) {
				adElement = ascGetDiv(config.elementId);
			} else {
				adElement = window.document.getElementById(config.elementId);
			}
			if (!adElement) {
				console.warn('ShowUnitBannerAd: element NOT found:', config.elementId);
				return;
			}
			adElement.style.display = '';
			adElement.style.visibility = 'visible';

			if (window.ascAds) {
				console.log('[ASC] ShowUnitBannerAd: entering provider check for "' + config.elementId + '"');
				console.log('[ASC]   gCrazySDK:', typeof gCrazySDK);
				console.log('[ASC]   window.ascAds:', window.ascAds);
				console.log('[ASC]   pbjs:', typeof pbjs);
				console.log('[ASC]   pbjs.refreshSlot:', typeof (pbjs || {}).refreshSlot);
				console.log('[ASC]   config.aipRefreshId:', config.aipRefreshId);
				console.log('[ASC]   aipDisplayTag:', typeof aipDisplayTag);
			}

			if (typeof gCrazySDK !== 'undefined') {
				if (config.crazySdkBannerIds && config.crazySdkBannerIds.length > 0) {
					gCrazySDK.requestResponsiveBanner(config.crazySdkBannerIds);
					adRefreshStates[config.timerId] = now;
				}
			} else if (window.ascAds && typeof pbjs !== 'undefined' && typeof pbjs.refreshSlot === 'function' && config.aipRefreshId) {
				console.log('[ASC] ShowUnitBannerAd: refreshing slot "' + config.aipRefreshId + '" for element "' + config.elementId + '"');
				pbjs.refreshSlot(config.aipRefreshId);
				SendEvent('event', 'asc_banner_requested');
				adRefreshStates[config.timerId] = now;
			} else if (typeof aipDisplayTag !== 'undefined' && config.aipRefreshId) {
				showTag(config.aipRefreshId);
				SendEvent('event', 'aip_banner_requested');
				adRefreshStates[config.timerId] = now;
			} else {
				// Ads are likely blocked
				if (config.adBlockedFallbackImage) {
					adElement.style.backgroundImage = `url(${config.adBlockedFallbackImage})`;
					SendEvent('event', 'banner_adblocked_message_shown');
				} else {
					SendEvent('event', 'banner_adblocked');
				}
			}
		}

		function ShowAd1() { // doRefresh parameter was unused
			if (/Android|webOS|iPhone|iPad|iPod|Opera Mini/i.test(navigator.userAgent)) { // Outer mobile check
 				return;
			}

			const commonConfig = {
				allowMobile: false, // ShowUnitBannerAd will re-check, this is for consistency
				minWindowWidth: 0,
				performProsperLegacyCheck: false,
				adBlockedFallbackImage: null, // Original ShowAd1 had no specific fallback image
			};

			if (typeof gCrazySDK !== 'undefined') {
				// gCrazySDK is active
				ShowUnitBannerAd({
					...commonConfig,
					timerId: "showAd1_gCrazySdkTimer",
					elementId: adPrefix+'_160x600',
					crazySdkBannerIds: [adPrefix+'_160x600'],
					aipRefreshId: null,
					refreshTimeout: 10000
				});

				ShowUnitBannerAd({
					...commonConfig,
					timerId: "showAd1_el2_gCrazySdkPath_visTimer",
					elementId: adPrefix+'_160x600_2',
					crazySdkBannerIds: null,
					aipRefreshId: null,
					refreshTimeout: 0
				});
			} else if (window.ascAds || typeof aipDisplayTag !== 'undefined') {
				ShowUnitBannerAd({
					...commonConfig,
					timerId: "showAd1_el1_aipTimer",
					elementId: adPrefix+'_160x600',
					crazySdkBannerIds: null,
					aipRefreshId: adPrefix+'_160x600',
					refreshTimeout: 0
				});
				ShowUnitBannerAd({
					...commonConfig,
					timerId: "showAd1_el2_aipTimer",
					elementId: adPrefix+'_160x600_2',
					crazySdkBannerIds: null,
					aipRefreshId: adPrefix+'_160x600_2',
					refreshTimeout: 0
				});
			} else {
				ShowUnitBannerAd({ ...commonConfig, timerId: "showAd1_el1_fallbackTimer", elementId: adPrefix+'_160x600', crazySdkBannerIds: null, aipRefreshId: null, refreshTimeout: 0 });
				ShowUnitBannerAd({ ...commonConfig, timerId: "showAd1_el2_fallbackTimer", elementId: adPrefix+'_160x600_2', crazySdkBannerIds: null, aipRefreshId: null, refreshTimeout: 0 });
			}
		}

