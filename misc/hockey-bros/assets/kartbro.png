	<!--
		Ad slot naming, published before the game bundle loads. Haxe (Main.adPrefix /
		Main.prerollUnit) reads these instead of hardcoding names, so the div ids the page
		renders and the ids the game asks for can never drift apart again.
	-->
	<script>
		window.adPrefix = "hockeybros-io";
		window.prerollId = "hockeybros.io_preroll";
